{
  "info": {
    "name": "VisionAdmin Master API Suite (Full CMS, Scopes, Catalog & RBAC)",
    "_postman_id": "visionadmin-master-suite-full-v2",
    "description": "Complete, end-to-end API collection for all VisionAdmin & TyresVision modules: Auth Login/Logout, Multi-Website & Multi-Store Channel Scopes, Scoped Catalog Search & Facets, Page Sections, CMS Pages, Blogs, Dynamic Attributes, Leads & Enquiries, Staff RBAC, Audit Logs, Settings, and Scrapers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5049",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "deeppatel.synex@gmail.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "Admin@123",
      "type": "string"
    },
    {
      "key": "websiteId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "storeId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "storeViewId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Authentication & Session Lifecycle",
      "item": [
        {
          "name": "0.1 Admin Login (Email & Password)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"remember\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/visionadmin/login",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "login"]
            }
          }
        },
        {
          "name": "0.2 Get Current Authenticated Profile (/me)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/me",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "me"]
            }
          }
        },
        {
          "name": "0.3 Update Current Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Deep Patel\",\n  \"email\": \"deeppatel.synex@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/profile",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "profile"]
            }
          }
        },
        {
          "name": "0.4 Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"12345678\",\n  \"new_password\": \"NewPassword2026!\",\n  \"confirm_password\": \"NewPassword2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "change-password"]
            }
          }
        },
        {
          "name": "0.5 Forgot Password (Request Reset Link)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"deeppatel.synex@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/visionadmin/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "forgot-password"]
            }
          }
        },
        {
          "name": "0.6 Admin Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/visionadmin/logout",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Multi-Website & Multi-Store Hierarchy",
      "item": [
        {
          "name": "1.1 Get Multi-Store Hierarchy Tree",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/scopes/tree",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "scopes", "tree"]
            }
          }
        },
        {
          "name": "1.2 Switch Active Website Scope (Global / Website / Store)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scope_type\": \"website\",\n  \"scope_id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/scopes/switch",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "scopes", "switch"]
