          }
        },
        {
          "name": "1.3 Switch to Specific Store Hub Scope (e.g. Dubai Retail Hub)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scope_type\": \"store\",\n  \"scope_id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/scopes/switch",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "scopes", "switch"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Public Storefront & Scoped Catalog APIs",
      "item": [
        {
          "name": "2.1 Scoped Product Catalog Search (Multi-Filter & Facets)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Website-Id", "value": "{{websiteId}}" },
              { "key": "X-Store-Id", "value": "{{storeId}}" },
              { "key": "X-Store-View-Id", "value": "{{storeViewId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/search?q=buy&brand=michelin&rim_size=17&page=1&per_page=12",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "catalog", "search"],
              "query": [
                { "key": "q", "value": "buy" },
                { "key": "brand", "value": "michelin" },
                { "key": "rim_size", "value": "17" },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "12" }
              ]
            }
          }
        },
        {
          "name": "2.2 Scoped Faceted Search Aggregations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Website-Id", "value": "{{websiteId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/facets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "catalog", "facets"]
            }
          }
        },
        {
          "name": "2.3 Submit Customer Lead / Quote Enquiry",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ahmed Al-Mansoor\",\n  \"phone\": \"+971501234567\",\n  \"email\": \"ahmed@example.com\",\n  \"city\": \"Dubai\",\n  \"vehicle_make\": \"Nissan\",\n  \"vehicle_model\": \"Patrol\",\n  \"vehicle_year\": 2023,\n  \"tyre_size\": \"275/60 R20\",\n  \"message\": \"Looking for 4 tyres with doorstep mobile van installation.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/enquiries",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "enquiries"]
            }
          }
        },
        {
          "name": "2.4 API Health & Version Manifest",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/version",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "version"]
            }
          }
        }
      ]
    },
