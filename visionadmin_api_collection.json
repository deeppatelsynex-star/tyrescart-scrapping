{
  "info": {
    "name": "VisionAdmin Master API Suite (Full CMS, Scopes, Catalog & RBAC)",
    "_postman_id": "visionadmin-master-suite-full-v1",
    "description": "Complete, end-to-end API collection for all VisionAdmin control plane modules: Profile, Uploads, Pages, Sections, Blogs, Categories, Enquiries, Staff Users, Reviewer Settings, Global Search, Audit Trail, Scopes, and Dynamic Attributes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5049",
      "type": "string"
    },
    {
      "key": "websiteId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "storeId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Admin Profile",
      "item": [
        {
          "name": "1.1 Get Current Admin Profile (/me)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/me",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "me"]
            }
          }
        },
        {
          "name": "1.2 Update Admin Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Deep Patel\",\n  \"email\": \"deeppatel.synex@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/profile",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "profile"]
            }
          }
        },
        {
          "name": "1.3 Change Admin Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"OldPassword123!\",\n  \"new_password\": \"NewSecurePass2026!\",\n  \"confirm_password\": \"NewSecurePass2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "change-password"]
            }
          }
        },
        {
          "name": "1.4 Delete Profile Avatar",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/profile/avatar",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "profile", "avatar"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Multi-Store Scopes & Global Search",
      "item": [
        {
          "name": "2.1 Global Search Autocomplete (Ctrl + K)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/global-search?q=buy",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "global-search"],
              "query": [{ "key": "q", "value": "buy" }]
            }
          }
        },
        {
          "name": "2.2 Get Scope Hierarchy Tree",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/scopes/tree",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "scopes", "tree"]
            }
          }
        },
        {
          "name": "2.3 Switch Active Scope",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scope_type\": \"website\",\n  \"scope_id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/scopes/switch",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "scopes", "switch"]
            }
          }
        },
        {
          "name": "2.4 API Version Manifest",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/version",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "version"]
            }
          }
        }
      ]
    },
    {
