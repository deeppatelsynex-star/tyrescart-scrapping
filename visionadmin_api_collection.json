            "body": {
              "mode": "raw",
              "raw": "{\n  \"page_slug\": \"home\",\n  \"section_type\": \"faq\",\n  \"section_title_en\": \"Frequently Asked Questions\",\n  \"section_title_ar\": \"الأسئلة الشائعة\",\n  \"section_subtitle_en\": \"Everything you need to know\",\n  \"section_subtitle_ar\": \"كل ما تحتاج لمعرفته\",\n  \"section_data\": [\n    {\n      \"q_en\": \"How long does mobile fitting take?\",\n      \"q_ar\": \"كم يستغرق تركيب الإطارات المتنقل؟\",\n      \"a_en\": \"30-45 minutes for 4 tyres.\",\n      \"a_ar\": \"من 30 إلى 45 دقيقة لـ 4 إطارات.\"\n    }\n  ],\n  \"sort_order\": 8,\n  \"is_active\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/sections",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "sections"]
            }
          }
        },
        {
          "name": "3.4 Update Section",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"section_title_en\": \"Updated FAQ Title\",\n  \"is_active\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/sections/1",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "sections", "1"]
            }
          }
        },
        {
          "name": "3.5 Batch Reorder Sections",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page_slug\": \"home\",\n  \"order\": [1, 2, 3, 4, 5, 6, 7, 8, 9]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/sections/reorder",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "sections", "reorder"]
            }
          }
        },
        {
          "name": "3.6 Delete Section",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/visionadmin/api/sections/1",
              "host": ["{{baseUrl}}"],
              "path": ["visionadmin", "api", "sections", "1"]
            }
          }
        }
      ]
    },
