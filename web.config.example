<?xml version="1.0" encoding="utf-8"?>
<!-- Sample web.config for Plesk on Windows Server with IIS & HttpPlatformHandler -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <!-- Update processPath to point to your virtualenv's waitress-serve.exe -->
    <httpPlatform processPath=".\venv\Scripts\waitress-serve.exe"
                  arguments="--port=%HTTP_PLATFORM_PORT% --threads=16 --channel-timeout=0 wsgi:app"
                  requestTimeout="00:30:00"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout.log">
      <environmentVariables>
        <environmentVariable name="PYTHONPATH" value=".\app;." />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
